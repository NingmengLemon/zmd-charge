<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EndfieldCharge.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <!-- 托盘右键菜单：Avalonia 的托盘弹窗用的是 MenuFlyoutPresenter
         （Avalonia.Win32 里私有的 TrayIconMenuFlyoutPresenter 把 StyleKeyOverride
         指向了 typeof(MenuFlyoutPresenter)，所以这里的选择器能命中它）。
         取值对齐原本自绘菜单的深色观感。 -->
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="#1E1E20"/>
      <Setter Property="BorderBrush" Value="#2A2A2C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="6"/>
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EndfieldCharge/Styles/HudTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
