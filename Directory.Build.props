<Project>

  <!-- ============================================================
       仓库内所有工程共享的编译属性。
       放在根目录，SDK 会自动向上查找并导入，tests/ 子目录里的工程同样生效。
       只放「两个工程都必须一致」的东西；主程序独有的发布相关属性留在
       EndfieldCharge.csproj 里，别让测试工程也被打上 RID。
       ============================================================ -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>

    <!-- 本地构建与 CI 用同一道闸门：警告即错误。CI 里不再单独传参，避免两处不一致 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- 打开推荐档分析器，并把 .editorconfig 里的代码风格规则也纳入构建 -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- IDE0005（多余的 using）在构建期要求生成 XML 文档文件，这是 Roslyn 的硬性前置条件
         （dotnet/roslyn#41640）。本项目是应用不是库，没有 API 消费方，所以顺手关掉
         「公开成员缺少 XML 注释」的 CS1591，只留下 IDE0005 这道闸门。
         CI 打便携包时会排除这个 .xml。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
