<Project>

  <!-- ============================================================
       中央包管理（CPM）：所有 PackageReference 的版本只在这里写一次，
       工程文件里只写 Include。避免同一个包在两个工程里各钉一个版本、
       升级时漏掉其中一个。

       升级某个包：改这里的 Version，然后 dotnet build。
       临时覆盖某工程：在该工程里写 <PackageReference ... VersionOverride="x" />。
       ============================================================ -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- 设置窗 ViewModel 的基类，以及 [ObservableProperty] / [RelayCommand] 源生成 -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 电池信息兜底读取（主路径是 powrprof P/Invoke，无需此包；WMI 仅作备用） -->
    <PackageVersion Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="测试">
    <!-- xunit v3：测试工程本身是可执行程序，跑测试不再需要外部 runner。
         Microsoft.Testing.Platform 由 xunit.v3 传递引入，所以不再需要 Microsoft.NET.Test.Sdk。
         xunit.runner.visualstudio 是给 IDE（VS / Rider）做发现用的，4.x 才支持 v3。 -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
