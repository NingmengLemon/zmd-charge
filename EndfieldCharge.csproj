<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings / LangVersion / PlatformTarget /
       TreatWarningsAsErrors / 分析器档位都在根目录的 Directory.Build.props 里，
       这里只放主程序独有的东西。 -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SettingsWindow 只在代码中带参构造，XAML 运行时加载器警告为误报 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tray_bolt.ico</ApplicationIcon>
    <AssemblyName>EndfieldCharge</AssemblyName>
    <RootNamespace>EndfieldCharge</RootNamespace>
    <Authors>Lenkmat</Authors>
    <Company>Lenkmat</Company>
    <Copyright>Copyright © 2026 Lenkmat</Copyright>

    <!-- 单文件发布，方便丢进开机启动 -->
    <PublishSingleFile Condition="'$(Configuration)'=='Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)'=='Release'">false</SelfContained>
    <!-- 无条件下发给 restore：CI 里 restore 不带 -c Release，若只有条件 RuntimeIdentifier，
         assets 里就不会有 net10.0-windows/win-x64 目标，build/publish 会报
         "Assets file doesn't have a target for 'net10.0-windows/win-x64'" -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Configuration)'=='Release'">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Services/PowerNative.cs 用 [LibraryImport]，它的源生成器会产出 unsafe 代码
         （SYSLIB1062 明确要求打开这个开关）。只给需要它的主工程开，不放共享属性里，
         免得测试工程也白白获得 unsafe 许可。我们自己不写 unsafe 代码。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ============================================================
       「检查更新」指向哪个仓库。
       CI 用 github.repository 覆盖（见 .github/workflows/build.yml），
       所以任何 fork 的 CI 产物都会查自己的 Release；
       本地构建（含 fork 后未改 CI）退回本仓库，不会指到别人的 fork。
       ============================================================ -->
  <PropertyGroup>
    <UpdateRepoOwner Condition="'$(UpdateRepoOwner)' == ''">NingmengLemon</UpdateRepoOwner>
    <UpdateRepoName Condition="'$(UpdateRepoName)' == ''">zmd-charge</UpdateRepoName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 编译期写入程序集元数据，运行时由 UpdateChecker 读取 -->
    <AssemblyMetadata Include="UpdateRepoOwner" Value="$(UpdateRepoOwner)" />
    <AssemblyMetadata Include="UpdateRepoName" Value="$(UpdateRepoName)" />
  </ItemGroup>

  <!-- 版本号统一由 Directory.Packages.props 管理 -->
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ 位于本项目目录树内，SDK 默认 glob 会把测试代码一起编进主程序，必须排除 -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试工程要直接验证 MapCue / 版本解析这类纯逻辑 -->
    <InternalsVisibleTo Include="EndfieldCharge.Tests" />
  </ItemGroup>

</Project>
