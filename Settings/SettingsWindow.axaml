<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:settings="using:EndfieldCharge.Settings"
        mc:Ignorable="d"
        d:DesignWidth="560" d:DesignHeight="520"
        x:Class="EndfieldCharge.Settings.SettingsWindow"
        x:DataType="settings:SettingsViewModel"
        Title="{Binding L.SettingsTitle}"
        Width="560" Height="520"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1C"
        Foreground="#E8E8E8"
        FontFamily="HarmonyOS Sans SC, HarmonyOS Sans, Inter, Microsoft YaHei UI, sans-serif">

  <!-- 左侧页签按钮：FluentTheme 的 Button 模板用 TemplateBinding 取 Background，
       所以这里设的底色在常态下生效；悬停/按下态仍走主题自己的观感。 -->
  <Window.Styles>
    <Style Selector="Button.tab">
      <Setter Property="Height" Value="38"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#E8E8E8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.tab.selected">
      <Setter Property="Background" Value="#2A2A2D"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- 标题栏 -->
    <Border Grid.Row="0" Height="48" Background="#202022" Padding="20,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="18" Height="18" CornerRadius="4.5" Background="#C6CA4C" VerticalAlignment="Center" ClipToBounds="True">
            <Image Width="14" Height="14" Source="avares://EndfieldCharge/Assets/tray_bolt.png"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding L.SettingsTitle}"
                     FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="#F0F0F0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="EndfieldCharge" FontSize="11"
                   Foreground="#888888" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- 主体 -->
    <Grid Grid.Row="1" ColumnDefinitions="140,*">
      <!-- 左侧 Tab -->
      <Border Background="#18181A">
        <StackPanel Margin="12,16,12,0" Spacing="4">
          <Button Classes="tab" Classes.selected="{Binding IsGeneralTab}"
                  Content="{Binding L.TabGeneral}"
                  Command="{Binding SelectTabCommand}" CommandParameter="General"/>
          <Button Classes="tab" Classes.selected="{Binding IsAnimationTab}"
                  Content="{Binding L.TabAnimation}"
                  Command="{Binding SelectTabCommand}" CommandParameter="Animation"/>
          <Button Classes="tab" Classes.selected="{Binding IsNotificationsTab}"
                  Content="{Binding L.TabNotifications}"
                  Command="{Binding SelectTabCommand}" CommandParameter="Notifications"/>
          <Button Classes="tab" Classes.selected="{Binding IsAboutTab}"
                  Content="{Binding L.TabAbout}"
                  Command="{Binding SelectTabCommand}" CommandParameter="About"/>
        </StackPanel>
      </Border>

      <!-- 右侧内容 -->
      <Border Grid.Column="1" Background="#1A1A1C">
        <ScrollViewer Margin="20,16,16,8">
          <StackPanel Spacing="0">

            <!-- 通用 Tab -->
            <StackPanel IsVisible="{Binding IsGeneralTab}" Spacing="0">
              <Border Background="#262628" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel Spacing="14">
                  <TextBlock Text="{Binding L.SectionDisplay}" FontSize="13" FontWeight="SemiBold"
                             Foreground="#C6CA4C" LetterSpacing="1"/>
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding L.LabelScale}" FontSize="12" Foreground="#888888"/>
                      <TextBlock Grid.Column="1" Text="{Binding GlobalScaleText}" FontSize="12"
                                 Foreground="#888888" Width="40" TextAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0.4" Maximum="1.2" TickFrequency="0.05"
                            Value="{Binding GlobalScale, Mode=TwoWay}" IsSnapToTickEnabled="False"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#262628" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel Spacing="14">
                  <TextBlock Text="{Binding L.SectionPosition}" FontSize="13" FontWeight="SemiBold"
                             Foreground="#C6CA4C" LetterSpacing="1"/>
                  <StackPanel Spacing="5">
                    <TextBlock Text="{Binding L.LabelPosition}" FontSize="12" Foreground="#888888"/>
                    <ComboBox Height="32"
                              ItemsSource="{Binding Positions}"
                              SelectedIndex="{Binding SelectedPositionIndex, Mode=TwoWay}"/>
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Text="{Binding L.LabelMonitor}" FontSize="12" Foreground="#888888"/>
                    <ComboBox Height="32"
                              ItemsSource="{Binding Monitors}"
                              SelectedIndex="{Binding SelectedMonitorIndex, Mode=TwoWay}"/>
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Text="{Binding L.LabelLanguage}" FontSize="12" Foreground="#888888"/>
                    <ComboBox Height="32"
                              ItemsSource="{Binding Languages}"
                              SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#262628" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel Spacing="14">
                  <TextBlock Text="{Binding L.SectionStartup}" FontSize="13" FontWeight="SemiBold"
                             Foreground="#C6CA4C" LetterSpacing="1"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding L.LabelAutoStart}" FontSize="13"/>
                      <TextBlock Text="{Binding L.DescAutoStart}" FontSize="11" Foreground="#888888"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAutoStart, Mode=TwoWay}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 动画 Tab -->
            <StackPanel IsVisible="{Binding IsAnimationTab}" Spacing="0">
              <Border Background="#262628" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel Spacing="14">
                  <TextBlock Text="{Binding L.SectionAnimParams}" FontSize="13" FontWeight="SemiBold"
                             Foreground="#C6CA4C" LetterSpacing="1"/>

                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding L.LabelDuration}" FontSize="12" Foreground="#888888"/>
                      <TextBlock Grid.Column="1" Text="{Binding DisplayDurationText}" FontSize="12"
                                 Foreground="#888888" Width="40" TextAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="3" Maximum="10" TickFrequency="0.5"
                            Value="{Binding DisplayDurationSeconds, Mode=TwoWay}" IsSnapToTickEnabled="False"/>
                  </StackPanel>

                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding L.LabelBounce}" FontSize="12" Foreground="#888888"/>
                      <TextBlock Grid.Column="1" Text="{Binding BounceStrengthText}" FontSize="12"
                                 Foreground="#888888" Width="40" TextAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="0.5" TickFrequency="0.025"
                            Value="{Binding BounceStrength, Mode=TwoWay}" IsSnapToTickEnabled="False"/>
                  </StackPanel>

                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding L.LabelRippleIntensity}" FontSize="12" Foreground="#888888"/>
                      <TextBlock Grid.Column="1" Text="{Binding RippleIntensityText}" FontSize="12"
                                 Foreground="#888888" Width="40" TextAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="2" TickFrequency="0.05"
                            Value="{Binding RippleIntensity, Mode=TwoWay}" IsSnapToTickEnabled="False"/>
                  </StackPanel>

                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding L.LabelRippleSpread}" FontSize="12" Foreground="#888888"/>
                      <TextBlock Grid.Column="1" Text="{Binding RippleSpreadText}" FontSize="12"
                                 Foreground="#888888" Width="40" TextAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0.5" Maximum="1.5" TickFrequency="0.05"
                            Value="{Binding RippleSpread, Mode=TwoWay}" IsSnapToTickEnabled="False"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#262628" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel Spacing="14">
                  <TextBlock Text="{Binding L.SectionPreview}" FontSize="13" FontWeight="SemiBold"
                             Foreground="#C6CA4C" LetterSpacing="1"/>
                  <StackPanel Spacing="5">
                    <TextBlock Text="{Binding L.LabelPlayMode}" FontSize="12" Foreground="#888888"/>
                    <ComboBox Height="32"
                              ItemsSource="{Binding PreviewModes}"
                              SelectedIndex="{Binding SelectedPreviewModeIndex, Mode=TwoWay}"/>
                  </StackPanel>
                  <Button Height="34" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                          Content="{Binding L.BtnPlay}"
                          Command="{Binding PlayPreviewCommand}"
                          IsEnabled="{Binding !IsPlayingPreview}"
                          Background="#C6CA4C" Foreground="#1A1A1C"
                          FontWeight="SemiBold" FontSize="13"
                          CornerRadius="8" Cursor="Hand"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 通知 Tab -->
            <StackPanel IsVisible="{Binding IsNotificationsTab}" Spacing="0">
              <Border Background="#262628" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel Spacing="18">
                  <TextBlock Text="{Binding L.SectionAlertSettings}" FontSize="13" FontWeight="SemiBold"
                             Foreground="#C6CA4C" LetterSpacing="1"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding L.LabelPowerSaverNotify}" FontSize="13"/>
                      <TextBlock Text="{Binding L.PowerSaverNotifyDesc}" FontSize="11" Foreground="#888888"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnablePowerSaverNotify, Mode=TwoWay}"/>
                  </Grid>
                  <Border Height="1" Background="#2A2A2C"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding L.LabelLowBatteryEnable}" FontSize="13"/>
                      <TextBlock Text="{Binding L.DescLowBatteryAlert}" FontSize="11" Foreground="#888888"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableLowBatteryAlert, Mode=TwoWay}"/>
                  </Grid>
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding L.LabelLowBattery}" FontSize="12" Foreground="#888888"/>
                      <TextBlock Grid.Column="1" Text="{Binding LowBatteryThresholdText}" FontSize="12"
                                 Foreground="#888888" Width="40" TextAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="5" Maximum="40" TickFrequency="5"
                            Value="{Binding LowBatteryThreshold, Mode=TwoWay}"
                            IsEnabled="{Binding EnableLowBatteryAlert}"
                            IsSnapToTickEnabled="True"/>
                  </StackPanel>
                  <Border Height="1" Background="#2A2A2C"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding L.LabelFullChargeEnable}" FontSize="13"/>
                      <TextBlock Text="{Binding L.DescFullChargeAlert}" FontSize="11" Foreground="#888888"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableFullChargeAlert, Mode=TwoWay}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 关于 Tab -->
            <StackPanel IsVisible="{Binding IsAboutTab}" Spacing="0">
              <Border Background="#262628" CornerRadius="10" Padding="20,20" Margin="0,0,0,14">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                  <Border Width="48" Height="48" CornerRadius="12" Background="#2A2A2D"
                          HorizontalAlignment="Center">
                    <Image Width="28" Height="28"
                           Source="avares://EndfieldCharge/Assets/tray_bolt.png"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="EndfieldCharge" FontSize="18" FontWeight="Bold"
                             HorizontalAlignment="Center" Foreground="#F0F0F0"/>
                  <TextBlock Text="{Binding L.AboutSubtitle}" FontSize="12"
                             HorizontalAlignment="Center" Foreground="#888888"/>
                  <Border Height="1" Background="#2A2A2C" Margin="0,4"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="{Binding L.LabelVersion}" FontSize="12"
                               Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VersionText}" FontSize="13"
                               FontWeight="SemiBold" Foreground="#F0F0F0"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="{Binding L.LabelAuthor}" FontSize="12"
                               Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Text="Lenkmat" FontSize="13"
                               FontWeight="SemiBold" Foreground="#F0F0F0"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                  <Border Height="1" Background="#2A2A2C" Margin="0,4"/>
                  <Button Height="34" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                          Content="{Binding L.BtnCheckUpdate}"
                          Command="{Binding CheckUpdateCommand}"
                          IsEnabled="{Binding !IsCheckingUpdate}"
                          Background="#2A2A2D" Foreground="#E0E0E0"
                          BorderThickness="1" BorderBrush="#3A3A3C"
                          CornerRadius="8"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  <TextBlock Text="{Binding UpdateStatus}" FontSize="11"
                             Foreground="#888888" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- 字体安装 -->
              <Border Background="#262628" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Binding L.FontSectionTitle}" FontSize="13" FontWeight="SemiBold"
                             Foreground="#C6CA4C" LetterSpacing="1"/>
                  <TextBlock Text="{Binding L.FontDesc}"
                             FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>
                  <Button Height="34" HorizontalAlignment="Stretch"
                          Content="{Binding L.BtnInstallFont}"
                          Command="{Binding InstallFontCommand}"
                          IsEnabled="{Binding !IsInstallingFont}"
                          Background="#2A2A2D" Foreground="#E0E0E0"
                          BorderThickness="1" BorderBrush="#3A3A3C"
                          CornerRadius="8"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  <TextBlock Text="{Binding FontStatus}" FontSize="11"
                             Foreground="#888888" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- 底部保存栏 -->
    <Border Grid.Row="2" Height="56" Background="#202022" Padding="20,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding L.SavedToast}" FontSize="12" Foreground="#C6CA4C"
                   VerticalAlignment="Center" Opacity="{Binding SavedHintOpacity}"/>
        <Button Grid.Column="2"
                Height="34" Width="110"
                HorizontalAlignment="Right"
                Content="{Binding L.BtnSave}"
                Command="{Binding SaveCommand}"
                Background="#C6CA4C" Foreground="#1A1A1C"
                FontWeight="SemiBold" FontSize="13"
                CornerRadius="8" Cursor="Hand"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
