<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       HUD 主题：严格对齐原视频实测取色
       胶囊 #312F30 实心；文字纯白靠 Opacity 分层；
       唯一彩色是徽章的黄绿色（低电量时换成 BadgeLow 红）。

       这里是 HUD 配色的唯一真源：HudWindow.axaml 与 HudWindow.axaml.cs
       都从这里取值。改动前请注意，别在别处再抄一份字面量。
       ============================================================ -->

  <!-- ==== 胶囊背景：实心深炭色，无渐变 ==== -->
  <Color x:Key="Hud.Pill">#FF312F30</Color>

  <!-- ==== 白色圆底 / 方块图标底 ==== -->
  <Color x:Key="Hud.IconPlate">#FFE9E7E4</Color>
  <Color x:Key="Hud.BoltDark">#FF141313</Color>

  <!-- ==== 文字：纯白，层级靠不透明度 ==== -->
  <Color x:Key="Hud.TextPrimary">#FFFFFFFF</Color>
  <x:Double x:Key="Hud.TextSecondaryOpacity">0.55</x:Double>
  <x:Double x:Key="Hud.TextTertiaryOpacity">0.40</x:Double>

  <!-- ==== 徽章：常态黄绿，低于低电量阈值时转红 ==== -->
  <Color x:Key="Hud.Accent">#FFC6CA4C</Color>
  <Color x:Key="Hud.BadgeLow">#FF4D4F</Color>
  <Color x:Key="Hud.BadgeDark">#FF262425</Color>

  <!-- ==== 提醒卡 / 消息框 ====
       原来这几组颜色硬编码在 App.axaml.cs 与 SettingsWindow.axaml.cs 的代码里，
       和 HUD 配色各存一份。搬进 XAML 后统一收到这里。
       标题与主按钮底色复用 Hud.Accent。 -->
  <Color x:Key="Dialog.Window">#FF18181A</Color>
  <Color x:Key="Dialog.Card">#FF232325</Color>
  <Color x:Key="Dialog.Body">#FFC8C8C8</Color>
  <Color x:Key="Dialog.MessageBox">#FF1E1E1E</Color>
  <Color x:Key="Dialog.ButtonText">#FF1E1E1E</Color>
  <!-- 窗口边缘。刻意自己画而不是交给窗口管理器：WindowDecorations="BorderOnly"
       在 KDE 下会被 KWin 用主题色描一圈（浅色主题就是一条白边），和深色卡片打架。 -->
  <Color x:Key="Dialog.Edge">#FF2A2A2C</Color>

  <!-- ==== 无衬线字体族（Inter 优先，中文回退到系统黑体，均无描边） ==== -->
  <FontFamily x:Key="Hud.FontFamily">"HarmonyOS Sans SC", "HarmonyOS Sans", Inter, "Microsoft YaHei UI", "PingFang SC", sans-serif</FontFamily>

  <!-- ==== 数字 / 英文字体：Inter Medium，中文回退到系统黑体 ==== -->
  <FontFamily x:Key="Hud.FontFamilyNumeric">"Inter Medium", "HarmonyOS Sans SC Medium", "HarmonyOS Sans Medium", Inter, "Microsoft YaHei UI", "PingFang SC", sans-serif</FontFamily>

</ResourceDictionary>
